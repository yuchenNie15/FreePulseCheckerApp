PRODUCT_NAME = FreePulseCheck
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).FreePulseCheck
CODE_SIGN_ENTITLEMENTS = Config/FreePulseCheck.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
SWIFT_EMIT_LOC_STRINGS = YES

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Free Pulse Check
INFOPLIST_KEY_NSCameraUsageDescription = Free Pulse Check uses the rear camera and flash to see the pulse in your fingertip.
INFOPLIST_KEY_NSMotionUsageDescription = Free Pulse Check uses motion to discard readings taken while the phone moves.
INFOPLIST_KEY_NSHealthUpdateUsageDescription = Free Pulse Check saves your heart rate and heart rate variability to Apple Health when you choose to.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIRequiredDeviceCapabilities = camera-flash
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
